    "type": "Section",
    "layout": "list",
    "content": {
      "header": {
        "eyebrow": "Maloya",
        "text": ["Saint-Denis · La Réunion · concept fictif.", "Création du site : Channy How-Choong · Chow Studio."],
        "links": [
          { "label": "Concerts", "href": "/concerts", "intent": "navigate" },
          { "label": "Musique", "href": "/musique", "intent": "navigate" },
          { "label": "Presse", "href": "/presse", "intent": "navigate" },
          { "label": "Booking", "href": "/contact", "intent": "contact" },
          { "label": "Mentions légales", "href": "/mentions-legales", "intent": "navigate" }
        ]
