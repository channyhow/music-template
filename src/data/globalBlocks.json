{
  "home-opening": {
    "id": "home-opening",
    "type": "Section",
    "layout": "media-overlay",
    "motion": "scene",
    "content": {
      "header": {
        "eyebrow": "Maloya · La Réunion",
        "title": "Musique réunionnaise, scène vivante.",
        "text": ["Un concept immersif où le live arrive avant la biographie : écouter, voir la prochaine date, puis entrer dans l’univers du groupe."],
        "links": [
          { "label": "Voir les concerts", "href": "/concerts", "intent": "navigate", "priority": "primary" },
          { "label": "Écouter", "href": "/musique", "intent": "navigate", "priority": "secondary" }
        ]
      },
      "media": "home-cover"
    }
  },
  "concerts-featured": {
    "id": "concerts-featured",
    "type": "Section",
    "layout": "carousel",
    "source": { "collection": "concerts", "query": { "featured": true, "limit": 3 } },
    "content": {
      "header": {
        "eyebrow": "Concerts",
        "title": "La prochaine date ne devrait jamais être difficile à trouver.",
        "text": ["Les dates visibles ici proviennent du concept Maloya et restent fictives."
        ]
      }
    }
  },
  "music-featured": {
    "id": "music-featured",
    "type": "Section",
    "layout": "carousel",
    "source": { "collection": "music", "query": { "featured": true, "limit": 4 } },
    "content": {
      "header": {
        "eyebrow": "Musique",
        "title": "Des disques comme des paysages.",
        "text": ["Les projets fictifs du concept deviennent un catalogue facile à parcourir et directement relié à l’écoute."]
      }
    }
  },
  "press-featured": {
    "id": "press-featured",
    "type": "Section",
    "layout": "grid",
    "source": { "collection": "press", "query": { "featured": true, "limit": 3 } },
    "content": {
      "header": {
        "eyebrow": "Presse & archive",
        "title": "Donner du contexte à la scène.",
        "text": ["Articles, interviews et kit professionnel structurent la preuve et facilitent le travail des programmateurs et journalistes."]
      }
    }
  },
  "booking-default": {
    "id": "booking-default",
    "type": "Section",
    "layout": "split",
    "frame": true,
    "content": {
      "header": {
        "eyebrow": "Booking",
        "title": "Programmer Maloya.",
        "text": ["Un formulaire professionnel séparé des messages du public pour qualifier date, lieu, contexte et besoins dès le premier contact."]
      },
      "form": "reservation"
    }
  },
  "contact-default": {
    "id": "contact-default",
    "type": "Section",
    "layout": "split",
    "content": {
      "header": {
        "eyebrow": "Contact",
        "title": "Une date, une collaboration, un mot après un concert.",
        "text": ["Le sujet du message oriente la demande vers booking, presse, collaboration ou contact général."]
      },
      "form": "contact"
    }
  },
  "social-default": {
    "id": "social-default",
    "type": "Section",
    "layout": "statement",
    "content": {
      "header": {
        "eyebrow": "Écouter · regarder · suivre",
        "title": "Prolonger la scène ailleurs.",
        "links": [
          { "label": "Spotify", "href": "https://spotify.com/maloya.band", "intent": "navigate" },
          { "label": "YouTube", "href": "https://youtube.com/maloya.band", "intent": "navigate" },
          { "label": "Instagram", "href": "https://instagram.com/maloya.band", "intent": "navigate" }
        ]
      }
    }
  },
  "final-cta": {
    "id": "final-cta",
    "type": "Section",
    "layout": "statement",
    "tone": "inverse",
    "content": {
      "header": {
        "eyebrow": "Prochaine étape",
        "title": "Voir Maloya sur scène, ou les faire venir sur la vôtre.",
        "links": [
          { "label": "Voir les dates", "href": "/concerts", "intent": "navigate", "priority": "primary" },
          { "label": "Booking professionnel", "href": "/contact", "intent": "contact", "priority": "secondary" }
        ]
      }
    }
  },
  "links-profile": {
    "id": "links-profile",
    "type": "Section",
    "layout": "statement",
    "content": {
      "header": {
        "title": "Maloya",
        "text": ["Musique réunionnaise, scène vivante · concept fictif."],
        "media": "music-live"
      }
    }
  },
  "links-primary": {
    "id": "links-primary",
    "type": "Section",
    "layout": "list",
    "source": { "collection": "links", "query": { "group": "primary", "enabled": true } }
  },
  "legal-notice-default": {
    "id": "legal-notice-default",
    "type": "Section",
    "layout": "text",
    "content": {
      "header": { "title": "Mentions légales" },
      "items": [
        {
          "title": "Projet fictif",
          "text": ["Maloya est un groupe fictif imaginé dans le cadre d’une étude de cas créative. Le projet n’est affilié à aucun groupe réel, label ou structure existante."]
        },
        {
          "title": "Direction artistique & développement",
          "text": ["Concept, design et développement réalisés par Chow Studio autour de la musique, du live et des paysages réunionnais."]
        },
        {
          "title": "Hébergement",
          "text": ["Le site est hébergé par Netlify, Inc. Les informations doivent être vérifiées au moment de la publication."]
        }
      ]
    }
  },
  "site-footer": {
