{
  "contact": {
    "id": "contact-form",
    "name": "contact",
    "submitLabel": "Envoyer",
    "fields": [
      { "name": "name", "label": "Nom", "type": "text", "required": true },
      { "name": "email", "label": "E-mail", "type": "email", "required": true },
      {
        "name": "subject",
        "label": "Sujet",
        "type": "select",
        "options": [
          { "label": "Booking / programmation", "value": "booking" },
          { "label": "Presse", "value": "press" },
          { "label": "Collaboration", "value": "collaboration" },
          { "label": "Message au groupe", "value": "message" }
        ]
      },
      { "name": "message", "label": "Message", "type": "textarea", "required": true }
    ]
  },
  "reservation": {
    "id": "booking-form",
    "name": "booking",
    "submitLabel": "Envoyer la demande de booking",
    "fields": [
      { "name": "name", "label": "Nom / structure", "type": "text", "required": true },
      { "name": "email", "label": "E-mail professionnel", "type": "email", "required": true },
      { "name": "phone", "label": "Téléphone", "type": "tel" },
      { "name": "date", "label": "Date envisagée", "type": "date" },
      { "name": "location", "label": "Lieu / ville", "type": "text" },
      { "name": "message", "label": "Projet", "type": "textarea", "required": true, "placeholder": "Événement, jauge, contexte, budget indicatif, besoins techniques…" }
    ]
  }
}
